# GBRUNCH replacement-kernel overrides shared by every kernel profile. Applied on top of the
# recovery's embedded config by tools/build_profile_kernel.py, before the profile fragment.
# Format: Kconfig fragment (CONFIG_X=y|m|"str" or "# CONFIG_X is not set").
#
# No Rust toolchain is pinned, so the Rust ashmem driver and Rust binder are replaced by the C
# binder (stock Google already has ANDROID_BINDER_IPC=y) and the memfd ashmem shim
# (gki-kernel/patches/0001). Everything else that touches the ABI between kernel and Google's
# user space (binder devices, dm-verity, erofs, f2fs, ...) is inherited from the stock config.
# CONFIG_RUST is not set
# CONFIG_ANDROID_BINDER_IPC_RUST is not set
CONFIG_MEMFD_ASHMEM_SHIM=y
# The stock kernel trims and protects exports for its KMI. A replacement kernel builds every
# module itself, so neither matters; trimming would only hide symbols from our modules.
# (MODULE_SIG_PROTECT is def_bool y whenever the list is non-empty, so clear the list.)
# CONFIG_TRIM_UNUSED_KSYMS is not set
CONFIG_MODULE_SIG_PROTECT_LIST=""
# No module signatures: the stock kernel does not enforce them (MODULE_SIG_FORCE=n), the modules live
# on GBRUNCH's own read-only partitions, and a per-build random signing key would make every module (and
# so the profile's compat.ext4, whose hash the installer pins) differ between otherwise identical builds.
# CONFIG_MODULE_SIG is not set
# Smaller and faster to build; nothing here reads the debug info.
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_IKHEADERS is not set
# Ruby loads system_heap.ko (/dev/dma_heap/system), battery.ko and (via GBRUNCH) ac.ko from
# modules; build them in so no insmod line depends on the kernel release.
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_ACPI_AC=y
CONFIG_ACPI_BATTERY=y
# Google user space uses VEX AVX-VNNI as a compiler baseline (gki-kernel/patches/0002).
CONFIG_GBRUNCH_AVXVNNI_EMU=y
# The stock value 0 registers no 8250 ports at all; GBRUNCH already passes 8250.nr_uarts=4 on the
# command line. 4 is the upstream default and is also what the Surface Aggregator UART needs.
CONFIG_SERIAL_8250_RUNTIME_UARTS=4

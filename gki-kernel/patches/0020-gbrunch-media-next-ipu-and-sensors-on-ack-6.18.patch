--- /dev/null
+++ b/include/media/gbrunch-alloc-compat.h
@@ -0,0 +1,22 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * GBRUNCH: 6.18 has kmalloc_obj()/kzalloc_obj()/k[mz]alloc_objs() with a mandatory gfp argument; later
+ * kernels default it to GFP_KERNEL. Drivers backported from those kernels call them without it, so
+ * redefine them with the gfp argument optional (same allocation, same __alloc_objs() underneath).
+ */
+#ifndef _GBRUNCH_ALLOC_COMPAT_H
+#define _GBRUNCH_ALLOC_COMPAT_H
+#include <linux/slab.h>
+#define __gbrunch_gfp1(gfp, ...) gfp
+#define __gbrunch_gfp(...) __gbrunch_gfp1(__VA_ARGS__ __VA_OPT__(,) GFP_KERNEL)
+#undef kmalloc_obj
+#undef kzalloc_obj
+#undef kmalloc_objs
+#undef kzalloc_objs
+#define kmalloc_obj(VAR_OR_TYPE, ...) __alloc_objs(kmalloc, __gbrunch_gfp(__VA_ARGS__), typeof(VAR_OR_TYPE), 1)
+#define kzalloc_obj(VAR_OR_TYPE, ...) __alloc_objs(kzalloc, __gbrunch_gfp(__VA_ARGS__), typeof(VAR_OR_TYPE), 1)
+#define kmalloc_objs(VAR_OR_TYPE, COUNT, ...) \
+	__alloc_objs(kmalloc, __gbrunch_gfp(__VA_ARGS__), typeof(VAR_OR_TYPE), COUNT)
+#define kzalloc_objs(VAR_OR_TYPE, COUNT, ...) \
+	__alloc_objs(kzalloc, __gbrunch_gfp(__VA_ARGS__), typeof(VAR_OR_TYPE), COUNT)
+#endif

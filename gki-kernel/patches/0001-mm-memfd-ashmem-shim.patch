From: gbOS86 contributors <https://github.com/linuxkid473/gbos-x86>
Subject: [PATCH] mm: ashmem ioctls on memfd for kernels built without the Rust ashmem driver

Android's libcutils only uses memfd for ashmem regions when the kernel answers
ASHMEM_GET_SIZE on a memfd; otherwise it falls back to /dev/ashmem. The ACK ashmem
driver is Rust (CONFIG_ASHMEM depends on RUST), so a C-only replacement kernel has
neither, and every shared Bitmap allocation fails ("Failed to create shared Bitmap"
in the setup wizard). This adds a C port of ashmem_memfd_ioctl() behind
CONFIG_MEMFD_ASHMEM_SHIM (mm/Makefile in this ACK revision already carries the
obj- line) and lets mm/shmem.c wire the memfd ioctls for either implementation.

Source: gbos-x86 kernel/ashmem_shim/ (memfd-ashmem-shim.c and apply.sh), GPL-2.0,
converted to a git patch against kernel/common 3938c8d97142 for GBRUNCH.
---
diff --git a/mm/Kconfig b/mm/Kconfig
index 69fd6fc84..a4c320b76 100644
--- a/mm/Kconfig
+++ b/mm/Kconfig
@@ -1290,6 +1290,15 @@ config KMAP_LOCAL_NON_LINEAR_PTE_ARRAY
 config MEMFD_CREATE
 	bool "Enable memfd_create() system call" if EXPERT
 
+config MEMFD_ASHMEM_SHIM
+	bool "ashmem ioctls on memfd without the Rust ashmem driver"
+	depends on MEMFD_CREATE && !ASHMEM
+	default y
+	help
+	  Answers the ashmem ioctls (ASHMEM_GET_SIZE, SET_NAME, ...) on memfd files so that
+	  Android's libcutils uses memfd instead of /dev/ashmem on kernels built without the
+	  Rust ashmem driver. C port of ashmem_memfd_ioctl() in drivers/staging/android/ashmem.rs.
+
 config SECRETMEM
 	default y
 	bool "Enable memfd_secret() system call" if EXPERT
diff --git a/mm/memfd-ashmem-shim.c b/mm/memfd-ashmem-shim.c
new file mode 100644
index 000000000..8b16fba4b
--- /dev/null
+++ b/mm/memfd-ashmem-shim.c
@@ -0,0 +1,105 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * ashmem ioctls on memfd files, for kernels built without the Rust ashmem driver (CONFIG_RUST=n).
+ *
+ * C port of ashmem_memfd_ioctl() in drivers/staging/android/ashmem.rs. libcutils only uses memfd
+ * for ashmem regions when the kernel answers ASHMEM_GET_SIZE on a memfd; otherwise it falls back
+ * to /dev/ashmem, which does not exist here, and every shared Bitmap allocation fails.
+ */
+#include <linux/capability.h>
+#include <linux/compat.h>
+#include <linux/dcache.h>
+#include <linux/fs.h>
+#include <linux/memfd.h>
+#include <linux/minmax.h>
+#include <linux/mman.h>
+#include <linux/string.h>
+#include <linux/uaccess.h>
+
+#include "../drivers/staging/android/ashmem.h"
+
+#define WRITE_SEALS_MASK (F_SEAL_WRITE | F_SEAL_FUTURE_WRITE)
+
+static long ashmem_memfd_get_name(struct file *file, void __user *argp)
+{
+	struct name_snapshot snap;
+	char name[ASHMEM_NAME_LEN];
+	const char *s;
+	size_t len;
+
+	take_dentry_name_snapshot(&snap, file->f_path.dentry);
+	s = snap.name.name;
+	if (!strncmp(s, "memfd:", 6))
+		s += 6;
+	len = min_t(size_t, strlen(s), ASHMEM_NAME_LEN - 1);
+	memcpy(name, s, len);
+	name[len] = '\0';
+	release_dentry_name_snapshot(&snap);
+
+	return copy_to_user(argp, name, len + 1) ? -EFAULT : 0;
+}
+
+long ashmem_memfd_ioctl(struct file *file, unsigned int cmd, unsigned long arg)
+{
+	unsigned long ino = file_inode(file)->i_ino;
+	unsigned long prot;
+	long seals, ret;
+
+#ifdef CONFIG_COMPAT
+	switch (cmd) {
+	case COMPAT_ASHMEM_SET_SIZE:
+		cmd = ASHMEM_SET_SIZE;
+		break;
+	case COMPAT_ASHMEM_SET_PROT_MASK:
+		cmd = ASHMEM_SET_PROT_MASK;
+		break;
+	case COMPAT_ASHMEM_GET_FILE_ID:
+		return put_user((u32)ino, (u32 __user *)compat_ptr(arg)) ? -EFAULT : 0;
+	}
+#endif
+
+	switch (cmd) {
+	case ASHMEM_GET_NAME:
+		return ashmem_memfd_get_name(file, (void __user *)arg);
+	case ASHMEM_GET_SIZE:
+		return i_size_read(file_inode(file));
+	case ASHMEM_SET_PROT_MASK:
+		seals = memfd_fcntl(file, F_GET_SEALS, 0);
+		if (seals < 0)
+			return seals;
+		/* The memfd compat layer does not support unsetting these. */
+		prot = arg | PROT_READ | PROT_EXEC;
+		if (seals & WRITE_SEALS_MASK) {
+			/* Can't add PROT bits. */
+			return (prot & PROT_WRITE) ? -EINVAL : 0;
+		}
+		if (!(prot & PROT_WRITE)) {
+			ret = memfd_fcntl(file, F_ADD_SEALS, F_SEAL_FUTURE_WRITE);
+			if (ret < 0)
+				return ret;
+		}
+		return 0;
+	case ASHMEM_GET_PROT_MASK:
+		seals = memfd_fcntl(file, F_GET_SEALS, 0);
+		if (seals < 0)
+			return seals;
+		return PROT_READ | PROT_EXEC | ((seals & WRITE_SEALS_MASK) ? 0 : PROT_WRITE);
+	case ASHMEM_GET_FILE_ID:
+		return put_user(ino, (unsigned long __user *)arg) ? -EFAULT : 0;
+	/* Just ignore unpin requests. */
+	case ASHMEM_PIN:
+		return ASHMEM_NOT_PURGED;
+	case ASHMEM_UNPIN:
+		return 0;
+	case ASHMEM_GET_PIN_STATUS:
+		return ASHMEM_IS_PINNED;
+	case ASHMEM_PURGE_ALL_CACHES:
+		return capable(CAP_SYS_ADMIN) ? 0 : -EPERM;
+	/* libcutils sets name and size where it creates the fd, knowing it is a memfd. */
+	case ASHMEM_SET_NAME:
+	case ASHMEM_SET_SIZE:
+		return -EINVAL;
+	default:
+		return -ENOTTY;
+	}
+}
diff --git a/mm/shmem.c b/mm/shmem.c
index c83f7f79f..15252f607 100644
--- a/mm/shmem.c
+++ b/mm/shmem.c
@@ -92,7 +92,7 @@ static struct vfsmount *shm_mnt __ro_after_init;
 
 #include "internal.h"
 
-#ifdef CONFIG_ASHMEM
+#if IS_ENABLED(CONFIG_ASHMEM) || IS_ENABLED(CONFIG_MEMFD_ASHMEM_SHIM)
 #include "../drivers/staging/android/ashmem.h"
 #endif
 
@@ -5294,7 +5294,7 @@ static const struct address_space_operations shmem_aops = {
 	.error_remove_folio = shmem_error_remove_folio,
 };
 
-#ifdef CONFIG_ASHMEM
+#if IS_ENABLED(CONFIG_ASHMEM) || IS_ENABLED(CONFIG_MEMFD_ASHMEM_SHIM)
 static long shmem_ashmem_ioctl(struct file *file, unsigned int cmd, unsigned long arg)
 {
 	if (!(SHMEM_I(file_inode(file))->flags & SHMEM_FL_MEMFD))
@@ -5316,7 +5316,7 @@ static const struct file_operations shmem_file_operations = {
 	.splice_write	= iter_file_splice_write,
 	.fallocate	= shmem_fallocate,
 #endif
-#ifdef CONFIG_ASHMEM
+#if IS_ENABLED(CONFIG_ASHMEM) || IS_ENABLED(CONFIG_MEMFD_ASHMEM_SHIM)
 	.unlocked_ioctl	= shmem_ashmem_ioctl,
 #ifdef CONFIG_COMPAT
 	.compat_ioctl	= shmem_ashmem_ioctl,

<?xml version='1.0' encoding='utf-8'?>
<mixer enum_mixer_numeric_fallback="true">
	<!-- GBRUNCH surface-pro-7: control names and ranges from the device (gbrunch.audiodump, tinymix,
	2026-11-10): Realtek ALC274 through the HDA generic parser on the SOF sof-hda-generic card.
	Volume maxima are 0 dB (87 for the codec, 32 for the SOF PGAs). Jack switching is done by DRAS
	(Auto-Mute Mode disabled), with the "sof-hda-dsp Headphone" / "sof-hda-dsp Mic" input devices. -->
	<ctl name="Auto-Mute Mode" value="Disabled" />
	<ctl name="PGA1.0 1 Master Playback Volume" value="32 32" />
	<ctl name="PGA7.0 7 Master Playback Volume" value="32 32" />
	<ctl name="PGA8.0 8 Master Playback Volume" value="32 32" />
	<ctl name="PGA9.0 9 Master Playback Volume" value="32 32" />
	<ctl name="PGA30.0 30 Playback Volume" value="32 32" />
	<ctl name="PGA31.0 31 Playback Volume" value="32 32" />
	<ctl name="PGA2.0 2 Master Capture Volume" value="50 50" />
	<ctl name="Master Playback Switch" value="1" />
	<ctl name="Master Playback Volume" value="87" />
	<ctl name="Speaker Playback Switch" value="0 0" />
	<ctl name="Speaker Playback Volume" value="87 87" />
	<ctl name="Headphone Playback Switch" value="0 0" />
	<ctl name="Headphone Playback Volume" value="87 87" />
	<ctl name="Capture Switch" value="0 0" />
	<ctl name="Capture Volume" value="40 40" />
	<ctl name="Internal Mic Boost Volume" value="0 0" />
	<ctl name="Mic Boost Volume" value="0 0" />
	<path name="Speaker">
		<ctl name="Speaker Playback Switch" value="1 1" />
	</path>
	<path name="Headphone">
		<ctl name="Headphone Playback Switch" value="1 1" />
	</path>
	<path name="InternalMic">
		<ctl name="Capture Switch" value="1 1" />
	</path>
	<path name="Mic">
		<ctl name="Capture Switch" value="1 1" />
	</path>
	<path name="HDMI1" />
	<path name="HDMI2" />
	<path name="HDMI3" />
</mixer>

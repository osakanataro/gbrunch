# Microsoft Surface Pro 7 (Ice Lake: i3-1005G1 / i5-1035G4 / i7-1065G7, Iris Plus Gen11).
# Kernel fragment for tools/build_profile_kernel.py, applied after gki-kernel/common.config.
#
# GPU: xe.ko (Ruby's vendor driver) stops at Tiger Lake; Gen11 needs i915. Kept modular so it
# travels in the first-stage ramdisk like xe does today and can carry its own parameters.
CONFIG_DRM_I915=m
# ACPI_WMI is a module in the stock config, which caps ACPI_VIDEO at m; it rides in the ramdisk with i915.
CONFIG_ACPI_VIDEO=m
# Platform: LPSS I2C controllers (touch, sensors), Ice Lake pin controller, 8250 DesignWare UART
# (the Surface Aggregator Module sits on it), power/volume buttons.
CONFIG_PINCTRL_ICELAKE=y
CONFIG_MFD_INTEL_LPSS_PCI=y
CONFIG_I2C_DESIGNWARE_CORE=y
CONFIG_I2C_DESIGNWARE_PLATFORM=y
CONFIG_I2C_HID_ACPI=y
CONFIG_SERIAL_8250_DW=y
CONFIG_INPUT_SOC_BUTTON_ARRAY=m
# Surface Aggregator Module: battery, charger, performance profile; lid wake (GPE); the SP7
# registry entries (MSHW0116/MSHW0119) and the surface_gpe DMI entry are in mainline 6.18.
CONFIG_SURFACE_AGGREGATOR=m
CONFIG_SURFACE_AGGREGATOR_BUS=y
CONFIG_SURFACE_AGGREGATOR_REGISTRY=m
CONFIG_SURFACE_AGGREGATOR_HUB=m
CONFIG_BATTERY_SURFACE=m
CONFIG_CHARGER_SURFACE=m
CONFIG_SURFACE_PLATFORM_PROFILE=m
CONFIG_SURFACE_GPE=m
CONFIG_SURFACE_HOTPLUG=m
# Wi-Fi: Intel AX201 (CNVi, 8086:34f0) with the in-tree iwlwifi instead of Ruby's iwl7000 build.
CONFIG_WLAN_VENDOR_INTEL=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_IWLWIFI=m
CONFIG_IWLMVM=m
# Bluetooth: the AX201's Bluetooth is USB (8087:0026); Google's kernel only has Intel PCIe BT.
CONFIG_BT_HCIBTUSB=m
# Audio: SOF on Ice Lake with the HDA generic machine driver (Realtek ALC298 + DMIC, HDMI).
CONFIG_SND_SOC_SOF_TOPLEVEL=y
CONFIG_SND_SOC_SOF_PCI=m
CONFIG_SND_SOC_SOF_INTEL_TOPLEVEL=y
CONFIG_SND_SOC_SOF_ICELAKE=m
CONFIG_SND_SOC_SOF_HDA_LINK=y
CONFIG_SND_SOC_SOF_HDA_AUDIO_CODEC=y
CONFIG_SND_SOC_INTEL_SKL_HDA_DSP_GENERIC_MACH=m
CONFIG_SND_HDA_CODEC_REALTEK=m
CONFIG_SND_HDA_CODEC_HDMI=m
CONFIG_SND_HDA_I915=y
# Touchscreen and pen: Intel Precise Touch and Stylus over the iTouch MEI device (linux-surface driver,
# gki-kernel/patches/0006). Needs iptsd in user space for multitouch processing.
CONFIG_HID_IPTS=m
# microSD reader behind the SDHCI PCI controller.
CONFIG_MMC_SDHCI_PCI=m
# Cameras: IPU4P (8086:8a19) through the IPU6 driver from media next plus the IPU4P series (patches 0007-0020,
# https://github.com/ruslanbay/ipu4-drivers branch upstream). Front OV5693, rear OV8865 with the DW9719 focus
# motor, IR OV7251; INT3472 provides the sensor power/clock GPIOs. Firmware ipu4p_fw.bin is Microsoft's (not
# redistributable): extracted locally from the Windows camera driver package.
CONFIG_MEDIA_PCI_SUPPORT=y
CONFIG_VIDEO_INTEL_IPU6=m
CONFIG_VIDEO_INTEL_IPU6_IPU7=y
CONFIG_IPU_BRIDGE=m
CONFIG_VIDEO_OV5693=m
CONFIG_VIDEO_OV8865=m
CONFIG_VIDEO_OV7251=m
CONFIG_VIDEO_DW9719=m
CONFIG_INTEL_SKL_INT3472=m
